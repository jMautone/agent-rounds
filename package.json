{
  "name": "agent-rounds",
  "version": "0.0.0",
  "description": "Run a team of coding agents where the process is code: file contracts, enforced review rounds and a reproducible run log.",
  "type": "module",
  "bin": {
    "agent-rounds": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "check": "npm run lint && npm test && npm run build",
    "example": "tsx scripts/regenerate-example.ts"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "multi-agent",
    "orchestration",
    "cli",
    "review"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jMautone/agent-rounds.git"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
